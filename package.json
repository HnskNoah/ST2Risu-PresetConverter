{
  "name": "st2risu",
  "version": "0.1.0",
  "description": "SillyTavern preset -> RisuAI preset converter (generic)",
  "type": "module",
  "bin": {
    "st2risu": "dist/src/cli.js",
    "st2risu-mcp": "dist/src/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "convert": "node dist/src/cli.js",
    "mcp": "node dist/src/mcp.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=21"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
